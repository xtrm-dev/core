{
  "$metadata": {
    "description": "Canonical MCP servers for Pi runtime sync",
    "format": "Pi-native mcpServers entries (command/args + lifecycle + idleTimeout)",
    "note": "This file is for .pi/mcp.json sync. Claude uses .xtrm/config/claude.mcp.json instead."
  },
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "lifecycle": "lazy",
      "idleTimeout": 10
    },
    "deepwiki": {
      "command": "npx",
      "args": ["-y", "pi-mcp-adapter", "https://mcp.deepwiki.com/mcp"],
      "lifecycle": "lazy",
      "idleTimeout": 10
    },
    "github-grep": {
      "command": "npx",
      "args": ["-y", "pi-mcp-adapter", "https://mcp.grep.app"],
      "lifecycle": "lazy",
      "idleTimeout": 10
    },
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa,agent_run",
      "headers": { "x-api-key": "${EXA_API_KEY}" },
      "_notes": {
        "description": "Exa semantic web research, source retrieval, advanced search, and authenticated multi-step research",
        "auth": "OAuth preferred; anonymous search/fetch may be rate-limited; never commit the API key"
      }
    },
    "gitnexus": {
      "command": "gitnexus",
      "args": ["mcp"],
      "lifecycle": "lazy",
      "idleTimeout": 10
    },
    "specialists": {
      "command": "specialists",
      "args": [],
      "lifecycle": "lazy",
      "idleTimeout": 10
    }
  }
}
