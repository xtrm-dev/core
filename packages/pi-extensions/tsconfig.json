{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "typeRoots": ["../../node_modules/@types"],
        "types": ["node"]
    },
    "include": ["src/**/*", "extensions/**/*"],
    "exclude": ["node_modules", "**/*.test.ts", "tests"]
}
