{
  "name": "@jaggerxtrm/pi-extensions",
  "version": "0.15.2",
  "description": "Unified Pi extension entrypoint for xtrm-managed extensions",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "xtrm"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./registry": "./src/registry.ts"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "author": "xtrm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xtrm-dev/core.git",
    "directory": "packages/pi-extensions"
  },
  "homepage": "https://github.com/Jaggerxtrm/xtrm-tools/tree/main/packages/pi-extensions",
  "bugs": {
    "url": "https://github.com/Jaggerxtrm/xtrm-tools/issues"
  },
  "scripts": {
    "prepublishOnly": "npm run verify:runtime",
    "verify:runtime": "node -e \"const fs=require('fs');const required=['src/index.ts','src/registry.ts','extensions','themes'];const missing=required.filter((entry)=>!fs.existsSync(entry));if(missing.length){console.error('Missing publish runtime assets: '+missing.join(', '));process.exit(1);}console.log('Runtime assets present for npm publish.');\"",
    "typecheck": "npm run build --workspace @xtrm/contracts && tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "@jaggerxtrm/substrate": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@types/node": "^25.3.0",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3"
  },
  "files": [
    "src",
    "extensions",
    "themes",
    "MIGRATION_NOTES.md",
    "README.md"
  ],
  "peerDependenciesMeta": {
    "@jaggerxtrm/substrate": {
      "optional": true
    }
  }
}
