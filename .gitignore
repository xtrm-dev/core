.DS_Store
__pycache__/
*.py[cod]
.Python
venv/
.venv/
node_modules/
.vscode/
.idea/
*.swp
*.log
cli/node_modules
/vsync_repo
.gitnexus
.dmux/

# Dolt database files (added by bd init)
.dolt/
*.db

# TDD Guard runtime data
.claude/tdd-guard/data/

# Pi npm cache (symlink AND directory forms — executors sometimes create as symlink to abs path)
.pi/npm
.pi/npm/

# pnpm-workspace.yaml: generated by pnpm when invoked inside this npm-workspaces
# repo (specialist tooling occasionally shells out to pnpm in worktrees). Not
# part of xtrm-tools. Without this, executor checkpoint commits silently stage
# stray pnpm-workspace.yaml into chain branches (xtrm-ombq).
pnpm-workspace.yaml
cli/pnpm-workspace.yaml

# Skill eval workspaces (local eval artifacts, not for review)
skills/*-workspace/
.xtrm/skills/default/*-workspace/

# Git worktrees (managed by Claude Code)
.claude/worktrees/
.worktrees/
.xtrm/worktrees/
.xtrm/statusline-claim
.xtrm/debug.db
.xtrm-session-state.json
.session-meta.json
.xtrm/session-meta.json
.claude/skills/

.perles/

# bv (beads viewer) local config and caches
.bv/

.specialists/jobs/
.specialists/ready/
.specialists/trace.jsonl
packages/pi-extensions/extensions/xtrm-ui/.serena/
.xtrm/extensions/**/.pi/

# Beads runtime files (always modified, not meaningful to track)
.beads/dolt-monitor.pid
.beads/dolt-server.activity

# Quality-gates hook runtime cache (accumulates local machine paths)
hooks/tsconfig-cache.json
.xtrm/hooks/tsconfig-cache.json
.xtrm/session-meta.json

# Project-level skills symlink (runtime artifact, installed by xtrm)
.claude/skills

# Claude Code per-session local overrides (written per-worktree by xt claude /
# xt pi). Caught by user-global gitignore on most dev machines but listed here
# for portability so CI and fresh clones agree it is never tracked.
.claude/settings.local.json

# Skills runtime views (generated by xt init — not source)
.xtrm/skills/active/

# Legacy agent skills path (deprecated, replaced by .xtrm/skills/active/)
.agents/

# Keep synthesized memory under version control
!.xtrm/memory.md

.specialists/db/*.db
.specialists/db/*.db-wal
.specialists/db/*.db-shm

# Serena project metadata for nested package workspaces
.xtrm/packages/pi-extensions/.serena/

# Beads / Dolt files (added by bd init)
.beads-credential-key

# Beads / Dolt files (added by bd init)
.beads/proxieddb/

# Local provider OAuth credentials (never track account snapshots).
accounts/oauth_creds_*.json
accounts/

# Local agent/runtime dotfile artifacts (generated per checkout, not source)
.claude/settings.json
.claude/service-registry.json
.pi/
.serena/
.wolf/
.mcp.json
.zed/
.codex
.smoke-test
.specialists/executor-result.md
.beads/interactions.jsonl

# Nested tool runtime folders
cli/.pi/
packages/*/.serena/

# Per-session scratch + tool caches (documented in CLAUDE.md as untracked)
context.md
cli/.gemini/
.pytest_cache/
.ruff_cache/

# ────────────────────────────────────────────────────────────────
# Runtime dot dirs — follow ~/dev/specialists pattern.
# Existing tracked files stay tracked (git does not retroactively
# untrack); only NEW files under these dirs are ignored by default.
# Use `git add -f` to intentionally add a new file here.
# ────────────────────────────────────────────────────────────────
.beads/
.claude/
.pi/
.codex

# .xtrm/ is the SOURCE of canonical assets shipped in the npm tarball
# (see package.json `files`). Ignore everything by default, then
# re-include the canonical + currently-tracked paths.
.xtrm/*
!.xtrm/config/
!.xtrm/config/**
!.xtrm/hooks/
!.xtrm/hooks/**
!.xtrm/registry.json
!.xtrm/memory.md
!.xtrm/specialists-source.json
!.xtrm/cache/
!.xtrm/cache/**
.xtrm/cache/beads-status.json
.xtrm/cache/beads-status.lock
.xtrm/cache/beads-status.json.*.tmp
!.xtrm/ext-src/
!.xtrm/ext-src/**
!.xtrm/packages/
!.xtrm/packages/**
!.xtrm/skills/
!.xtrm/skills/INVARIANTS.md
!.xtrm/skills/state.json
!.xtrm/skills/default/
!.xtrm/skills/default/**
!.xtrm/skills/optional/
!.xtrm/skills/optional/**
!.xtrm/skills/user/
!.xtrm/skills/user/**
!.xtrm/skills/deferred/
!.xtrm/skills/deferred/**

# Re-exclude common runtime/cache noise deep in re-included .xtrm/ subtrees.
# Mirrors the exclusions in package.json `files`.
.xtrm/**/__pycache__/
.xtrm/**/*.pyc
.xtrm/**/.serena/
.xtrm/**/.pi/
.xtrm/skills/default/**/evals/
.xtrm/skills/default/**/workspace/iteration-*/
.xtrm/skills/default/*-workspace/

# gitnexus analyze runtime output (regenerated on demand)
.xtrm/skills/default/gitnexus/

# xtrm runtime state (per-machine, do not track)
.xtrm/skills/state.json
.xtrm/worktrees/
.xtrm/cache/
.xtrm/statusline-claim
.pi/skills/

# Beads / Dolt files (added by bd init)
*.gate.lock*

# Legacy specialists hook links (CORE-2414): never installed in-repo, unwired; do not track
.claude/hooks/specialists-*.mjs

# PR Lens writes its previews here. They are rebuilt on demand.
.pr-lens/
