{
  "name": "xtrm-tools",
  "version": "0.13.0",
  "description": "Durable multi-agent coding runtime for Pi, Claude Code, Codex, and Specialists",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "cli",
    "packages/pi-extensions",
    "packages/contracts"
  ],
  "bin": {
    "xtrm": "cli/dist/index.cjs",
    "xt": "cli/dist/index.cjs",
    "ghgrep": "scripts/ghgrep.mjs"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "cli/dist",
    "cli/package.json",
    "docs/runtime-compatibility.json",
    "scripts/ghgrep.mjs",
    ".xtrm/config",
    ".xtrm/hooks",
    "packages/pi-extensions",
    ".xtrm/skills/default",
    ".xtrm/skills/optional",
    ".xtrm/registry.json",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!.xtrm/hooks/tsconfig-cache.json",
    "!packages/pi-extensions/extensions/**/.pi/**",
    "!.xtrm/extensions/**/.pi/**",
    "!.xtrm/**/test_*.py",
    "!.xtrm/**/tests/**",
    "!.xtrm/skills/default/**/evals/**",
    "!.xtrm/skills/default/**/workspace/iteration-*/**",
    "!.xtrm/skills/default/*-workspace/**",
    "!.xtrm/skills/optional/**/evals/**",
    "!.xtrm/skills/optional/**/workspace/iteration-*/**",
    "!.xtrm/skills/optional/*-workspace/**",
    "!packages/*/.serena/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xtrm-dev/core.git"
  },
  "homepage": "https://github.com/xtrm-dev/core#readme",
  "bugs": {
    "url": "https://github.com/xtrm-dev/core/issues"
  },
  "scripts": {
    "sync:cli-version": "node scripts/sync-cli-version.mjs",
    "compile-policies": "node scripts/compile-policies.mjs",
    "check-policies": "node scripts/compile-policies.mjs --check",
    "check-pi": "node scripts/compile-policies.mjs --check-pi",
    "prebuild": "npm run sync:cli-version",
    "build": "npm run build:contracts && npm run build --workspace cli",
    "typecheck": "npm run typecheck --workspace cli",
    "start": "node cli/dist/index.cjs",
    "lint": "echo 'No linting configured'",
    "test": "npm test --workspace cli",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "test:contracts": "npm test --workspace @xtrm/contracts",
    "build:contracts": "npm run build --workspace @xtrm/contracts",
    "check:package": "node scripts/assert-no-self-dependency.mjs",
    "changelog:update": "node scripts/changelog-update.mjs",
    "changelog:check": "node scripts/changelog-update.mjs --check",
    "changelog:preview": "node scripts/changelog-update.mjs --preview",
    "version": "npm run changelog:update -- --tag v$npm_package_version && npm run sync:cli-version && git add CHANGELOG.md cli/package.json packages/pi-extensions/package.json",
    "check:skills-ownership": "node scripts/check-skills-ownership.mjs",
    "check:managed-skills": "node scripts/check-managed-skills.mjs",
    "check:specialists-vendor": "node scripts/verify-specialists-vendor.mjs",
    "check:asset-contract": "node scripts/verify-asset-contract.mjs",
    "check:layout-guards": "node scripts/check-layout-guards.mjs",
    "check:gitnexus-no-counter": "node scripts/check-gitnexus-no-counter.mjs",
    "check:skills-symlinks": "node scripts/check-skills-symlinks.mjs",
    "check:skill-root-budget": "node scripts/check-skill-root-budget.mjs",
    "check:forbidden-phrases": "node scripts/check-forbidden-phrases.mjs",
    "check:vendored-specialists-parity": "node scripts/check-vendored-specialists-skill-parity.mjs",
    "prepublishOnly": "npm run sync:cli-version && npm run check:package && npm run check:skills-ownership && npm run check:managed-skills && npm run check:deprecations && npm run check:pi-manifest && npm run check:runtime-compat && node scripts/vendor-specialists-from-manifest.mjs && npm run gen-registry && npm run check:registry-pack-parity && npm run check:payload-hygiene && npm run check:specialists-vendor && npm run check:managed-skills && npm run check:layout-guards && npm run check:gitnexus-no-counter && npm run check:skills-symlinks && npm run check:skill-root-budget && npm run check:forbidden-phrases && npm run check:vendored-specialists-parity && npm run build",
    "release": "npm publish --tag latest",
    "release:pi-extensions": "npm publish --workspace @jaggerxtrm/pi-extensions --tag latest --access public",
    "release:all": "npm run release && npm run release:pi-extensions",
    "gen-registry": "node scripts/gen-registry.mjs",
    "check:registry-freshness": "node scripts/gen-registry.mjs --check",
    "check:registry-pack-parity": "node scripts/check-registry-pack-parity.mjs",
    "check:payload-hygiene": "node scripts/check-payload-hygiene.mjs",
    "check:deprecations": "node scripts/check-command-deprecations.mjs",
    "check:pi-manifest": "node scripts/check-pi-extension-manifest.mjs",
    "check:runtime-compat": "node scripts/check-runtime-compatibility.mjs",
    "vendor:specialists": "node scripts/vendor-specialists-from-manifest.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "comment-json": "^4.2.3",
    "conf": "^15.1.0",
    "dotenv": "^17.3.1",
    "fs-extra": "^11.2.0",
    "kleur": "^4.1.5",
    "prompts": "^2.4.2"
  },
  "overrides": {
    "fast-uri": "^3.1.7",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "@aws-sdk/xml-builder": "3.972.22",
    "vite": "8.0.16",
    "esbuild": "0.28.1"
  },
  "pi": {
    "extensions": [
      "./packages/pi-extensions"
    ],
    "packages": [
      "npm:pi-gitnexus",
      "npm:@robhowley/pi-structured-return",
      "npm:@aliou/pi-guardrails",
      "npm:@narumitw/pi-goal",
      "git:github.com/DietrichGebert/ponytail",
      "npm:@tintinweb/pi-tasks",
      "npm:pi-background-tasks@latest",
      "npm:pi-mcp-adapter",
      "npm:pi-mermaid-viewer",
      "npm:@jaggerxtrm/pi-service-knowledge",
      "npm:pi-intercom",
      "git:github.com/alonw0/pi-claude-link",
      "npm:pi-ast-grep"
    ]
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.7",
      "nanoid": "^3.3.18",
      "postcss": "^8.5.23",
      "vite": "8.0.16",
      "esbuild": "0.28.1"
    }
  },
  "devDependencies": {
    "git-cliff": "2.13.1"
  }
}
