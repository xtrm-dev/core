{
  "name": "xtrm-cli",
  "private": true,
  "version": "0.15.3",
  "description": "Claude Code tools installer (skills, hooks, MCP servers)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xtrm-dev/core.git"
  },
  "homepage": "https://github.com/xtrm-dev/core#readme",
  "bugs": {
    "url": "https://github.com/xtrm-dev/core/issues"
  },
  "main": "./dist/index.js",
  "type": "module",
  "bin": {
    "xtrm": "dist/index.cjs",
    "xt": "dist/index.cjs",
    "ghgrep": "scripts/ghgrep.mjs"
  },
  "files": [
    "dist",
    "config",
    "scripts/ghgrep.mjs"
  ],
  "scripts": {
    "prebuild": "node scripts/build-guard.mjs prebuild",
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.cjs",
    "postbuild": "node scripts/build-guard.mjs postbuild"
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "comment-json": "^4.2.3",
    "conf": "^12.0.0",
    "dotenv": "^16.4.5",
    "fs-extra": "^11.2.0",
    "kleur": "^4.1.5",
    "listr2": "^10.1.1",
    "minimist": "^1.2.8",
    "ora": "^9.3.0",
    "project": "^0.1.6",
    "prompts": "^2.4.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.3.0",
    "@types/prompts": "^2.4.9",
    "@xtrm/contracts": "^0.13.0",
    "ajv": "^8.20.0",
    "esbuild": "0.28.2",
    "fast-check": "^4.10.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "8.3.8",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
